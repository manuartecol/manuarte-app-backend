# Copy this file to .env.development / .env.production / .env.test and fill in real values.
# NODE_ENV determines which .env.{NODE_ENV} file is loaded (defaults to development).

# Server
PORT=5000
CLIENT_URL=http://localhost:3000

# PostgreSQL
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Auth
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenAI
OPENAI_API_KEY=

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=

# Gema (WhatsApp agent)
WHATSAPP_AGENT_PHONE_NUMBER_ID=
WHATSAPP_BOT_USER_ID=
SHOP_CO_PHONE_NUMBER=
SHOP_EC_PHONE_NUMBER=

# Bold (Colombia payments)
BOLD_API_KEY=
BOLD_PAYMENT_BASE_URL=

# PayPhone (Ecuador payments)
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
PAYPHONE_PAYMENT_BASE_URL=

# Nequi (Colombia transfer info)
NEQUI_PHONE_NUMBER=
NEQUI_ACCOUNT_NAME=Manuarte

# Ecuador transfer/QR info
PAYMENT_QR_EC_INFO=

# Testing overrides — leave unset in production
TEST_FORCE_COUNTRY_ISO=
TEST_PAYPHONE_IN_CO=
