# Copiar a .env (o .env.development / .env.production / .env.test) y rellenar.
# NODE_ENV decide qué fichero .env.{NODE_ENV} se carga además de .env; por
# defecto, development. El único punto que lee process.env es src/config/env.ts,
# que sigue este mismo orden y define los valores por defecto.

# ── Servidor ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Origen permitido por CORS: la app de Next. Antes se llamaba CLIENT_URL.
FRONTEND_URL=http://localhost:3000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Requiere la extensión pgvector. En local, D:\workspace\infra\postgres-local.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────
# En local, D:\workspace\infra\redis-local (sin contraseña).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Autenticación ────────────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── WhatsApp Cloud API: credenciales comunes a todos los números ─────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ── Envío de documentos PDF desde el panel ───────────────────────────────────
# Número dedicado a cotizaciones y facturas, enviadas por plantilla. NO es una
# línea del agente: no recibe webhooks ni participa en la lógica de Coexistence.
WHATSAPP_DOCS_PHONE_NUMBER_ID=

# ── Agente Gema: líneas (Coexistence) ────────────────────────────────────────
# Cada línea es una operación independiente. El phone_number_id que llega en el
# webhook determina país, tienda, inventario y moneda: NO se usa el prefijo
# telefónico del cliente. Una línea sin PHONE_NUMBER_ID no se registra y sus
# eventos se ignoran, así que Ecuador queda inerte hasta que se configure.
#
# AI_ALLOWLIST_ENABLED ('true' por defecto) limita las respuestas de la IA a los
# números de AI_ALLOWLIST (separados por comas, con o sin '+'). Se deja activo
# durante las pruebas: una lista vacía silencia la IA en vez de soltarla sobre
# todos los clientes. Para automatizar a todos, poner 'false'.
WHATSAPP_LINE_CO_PHONE_NUMBER_ID=
WHATSAPP_LINE_CO_BUSINESS_PHONE=
WHATSAPP_LINE_CO_SHOP_SLUG=manuarte-barranquilla
WHATSAPP_LINE_CO_AI_ALLOWLIST_ENABLED=true
WHATSAPP_LINE_CO_AI_ALLOWLIST=

WHATSAPP_LINE_EC_PHONE_NUMBER_ID=
WHATSAPP_LINE_EC_BUSINESS_PHONE=
WHATSAPP_LINE_EC_SHOP_SLUG=manuarte-quito
WHATSAPP_LINE_EC_AI_ALLOWLIST_ENABLED=true
WHATSAPP_LINE_EC_AI_ALLOWLIST=

# ── Agente Gema: comportamiento ──────────────────────────────────────────────
# Pausa de IA tras intervención humana, en segundos. Se renueva con cada mensaje
# del personal; al expirar, la IA vuelve a atender la conversación. Bajarlo para
# pruebas afecta a TODAS las conversaciones de la línea.
WHATSAPP_AI_PAUSE_TTL_SECONDS=86400
# Usuario de esta aplicación con el que el agente firma lo que crea
# (`requestedBy` de cotizaciones y facturas). Es un UUID de la tabla de
# usuarios, no un identificador de WhatsApp.
AGENT_SYSTEM_USER_ID=

# ── Notificaciones a la tienda ───────────────────────────────────────────────
# Número que recibe copia de las cotizaciones y facturas en PDF, enviadas desde
# WHATSAPP_DOCS_PHONE_NUMBER_ID. También está en la denylist del agente: la IA
# nunca le responde.
# En Colombia coincide hoy con WHATSAPP_LINE_CO_BUSINESS_PHONE, porque la línea
# del agente es la propia tienda. No es un problema para los PDFs, que salen por
# otro número.
SHOP_NOTIFY_CO_PHONE=
SHOP_NOTIFY_EC_PHONE=

# ── Pagos ────────────────────────────────────────────────────────────────────
# Bold (Colombia) y PayPhone (Ecuador). Las URLs de ambas APIs están fijadas en
# payment-link.service.ts: no son configurables.
BOLD_API_KEY=
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
# Transferencia Nequi (Colombia)
NEQUI_PHONE_NUMBER=
NEQUI_ACCOUNT_HOLDER=Manuarte
# Datos de pago de Ecuador, tal cual se le envían al cliente. Provisional:
# hoy es texto de transferencia y pasará a ser un QR, como el de Colombia.
PAYMENT_QR_EC_INFO=

# ── Overrides de prueba — dejar vacíos en producción ─────────────────────────
# Con 'true' fuerza PayPhone aunque el país sea Colombia.
TEST_PAYPHONE_IN_CO=
